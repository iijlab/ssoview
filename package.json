{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm prd",
    "clean": "rimraf ./dist",
    "prd": "tsc -b && vite build",
    "dev": "vite build --mode=development --minify=false --sourcemap",
    "watch": "pnpm dev --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:browser:headed": "vitest --project browser --browser.headless=false",
    "coverage": "vitest run --coverage",
    "coverage:node": "vitest run --coverage --project node",
    "coverage:browser": "vitest run --coverage --project browser",
    "fmt": "prettier -w ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "fast-xml-parser": "^5.11.1",
    "js-base64": "^3.9.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.3.0",
    "@types/node": "^25.9.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "devtools-protocol": "^0.0.1698617",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
